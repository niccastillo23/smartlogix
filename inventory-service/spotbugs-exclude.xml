<?xml version="1.0" encoding="UTF-8"?>
<!--
  Filtro de exclusión de SpotBugs con justificación documentada (riesgo aceptado).

  SPRING_CSRF_PROTECTION_DISABLED (prioridad 1) en SecurityConfig:
  La API es stateless. El token JWT viaja en la cabecera Authorization: Bearer y nunca en cookies,
  por lo que un sitio de terceros no puede adjuntarlo automáticamente en una petición (requisito
  de un ataque CSRF). La sesión no se crea (SessionCreationPolicy.STATELESS). Por tanto, la
  protección CSRF no aporta mitigación adicional. Si en el futuro se almacenara el token en una
  cookie, esta exclusión debe retirarse y habilitarse CSRF.
-->
<FindBugsFilter>
  <Match>
    <Class name="com.smartlogix.inventory.config.SecurityConfig"/>
    <Bug pattern="SPRING_CSRF_PROTECTION_DISABLED"/>
  </Match>
</FindBugsFilter>
